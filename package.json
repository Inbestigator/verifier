{
  "name": "verifier",
  "type": "module",
  "scripts": {
    "dev": "bun --hot dev.ts",
    "register": "bun run build -r && bun start",
    "build": "dressed build && rm -rf dist && tsc -p ./tsconfig-build.jsonc",
    "start": "bun .dressed",
    "db:push": "drizzle-kit generate && drizzle-kit push",
    "checks": "tsc --noEmit && biome check --write"
  },
  "dependencies": {
    "@dressed/react": "^1.8.5-canary.2",
    "@dressed/ws": "^0.5.0-canary.1",
    "discord-api-types": "^0.38.47",
    "dressed": "^2.0.0-rc.2.1",
    "drizzle-orm": "^0.45.2",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.5",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@dressed/framework": "^0.5.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
